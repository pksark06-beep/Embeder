# Embeder BYOK LLM keys — copy to `.env` (git-ignored) and set ONE of these.
# The Codegen MCP server auto-detects the provider from whichever key is present.
# With no key set, the loop falls back to deterministic grounded synthesis.

# --- Google Gemini ---------------------------------------------------------
# GEMINI_API_KEY=your-gemini-key            # GEMINI_AI_KEY / GOOGLE_API_KEY also accepted
# EMBEDER_LLM_MODEL=gemini-3.6-flash        # optional; default gemini-3.6-flash

# --- Vercel AI Gateway (OpenAI-compatible) ---------------------------------
# AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
# EMBEDER_LLM_MODEL=openai/gpt-4o-mini      # optional; e.g. anthropic/claude-3.5-sonnet

# --- OpenAI (or any OpenAI-compatible endpoint) ----------------------------
# OPENAI_API_KEY=your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1 # optional override
# EMBEDER_LLM_MODEL=gpt-4o-mini             # optional

# --- Force a provider / disable ---------------------------------------------
# EMBEDER_LLM_PROVIDER=gemini | vercel | openai | none
